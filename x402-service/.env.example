# x402 AI Service Environment Configuration

# API Keys (for calling underlying AI services)
HF_TOKEN=your_huggingface_token_here
COHERE_API_KEY=your_cohere_api_key_here

# x402 Payment Configuration
X402_FACILITATOR_URL=https://open.x402.host
X402_NETWORK=base

# Receiving Wallet Address (where payments go - THIS IS THE SERVICE OPERATOR'S WALLET)
X402_RECEIVING_WALLET_ADDRESS=0x...  # Your wallet address that receives USDC payments

# Pricing Configuration (in USD cents)
K2_CHAT_COST=50          # $0.50 per K2 chat completion
COHERE_RERANK_COST=10    # $0.10 per rerank request
COHERE_CHAT_COST=5       # $0.05 per chat request
COHERE_EMBED_COST=2      # $0.02 per embed request

# Server Configuration
PORT=3000
NODE_ENV=development
