# Cohere API (for embeddings)
COHERE_API_KEY=your_cohere_api_key_here

# Anthropic API (for journey generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google AI (for Q&A)
GOOGLE_AI_API_KEY=your_google_ai_key_here

# HuggingFace API (for K2-Instruct)
HF_TOKEN=your_huggingface_token_here

# x402 AI Service Configuration
X402_SERVICE_URL=http://localhost:3000
X402_FACILITATOR_URL=https://open.x402.host
X402_NETWORK=base

# DocsBuddy Wallet (for signing payments - this is the PAYER)
X402_WALLET_PRIVATE_KEY=your_docsbuddy_wallet_private_key
X402_WALLET_ADDRESS=0x...  # DocsBuddy's wallet address (the payer)

# x402 Pricing Configuration (in USD cents)
X402_K2_CHAT_COST=50          # $0.50 per K2 chat completion
X402_COHERE_RERANK_COST=10    # $0.10 per rerank request
X402_COHERE_CHAT_COST=5       # $0.05 per chat request
X402_COHERE_EMBED_COST=2      # $0.02 per embed request

# Redis (for state management)
REDIS_URL=redis://localhost:6379

# ChromaDB (local by default)
CHROMA_DB_PATH=./chroma_db

# Available projects (comma-separated)
AVAILABLE_PROJECTS=privy,stripe,aws

# Default project
DEFAULT_PROJECT=privy