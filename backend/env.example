# Cohere API (for embeddings)
COHERE_API_KEY=your_cohere_api_key_here

# Anthropic API (for journey generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google AI (for Q&A)
GOOGLE_AI_API_KEY=your_google_ai_key_here

# HuggingFace API (for K2-Instruct)
HF_TOKEN=your_huggingface_token_here

# x402 AI Service Configuration (v2)
X402_SERVICE_URL=http://localhost:3000  # Updated to default port 3000
X402_FACILITATOR_URL=https://open.x402.host
X402_NETWORK=base
X402_PROTOCOL_VERSION=2  # Options: 1 (legacy), 2 (default)

# DocsBuddy Wallet (for signing payments - this is the PAYER)
X402_WALLET_PRIVATE_KEY=your_docsbuddy_wallet_private_key
X402_WALLET_ADDRESS=0x...  # DocsBuddy's wallet address (the payer)
# Note: Pricing is configured in the x402 service, not here

# Redis (for state management)
REDIS_URL=redis://localhost:6379

# ChromaDB (local by default)
CHROMA_DB_PATH=./chroma_db

# Available projects (comma-separated)
AVAILABLE_PROJECTS=privy,stripe,aws

# Default project
DEFAULT_PROJECT=privy